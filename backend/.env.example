# Copy to .env and fill in your own keys. Never commit .env.
DATABASE_URL=postgresql+asyncpg://slice:slice_dev@127.0.0.1:5432/ai_slice
ASR_PROVIDER=aliyun
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=paraformer-realtime-v2
DASHSCOPE_ASR_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_ASR_SAMPLE_RATE=16000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
STORAGE_DIR=./storage
TEMP_DIR=./tmp
WORKER_CONCURRENCY=10
FFMPEG_BIN_DIR=
